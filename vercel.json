{
  "rewrites": [
    {
      "source": "/render-api/:path*",
      "destination": "https://finnapigo.onrender.com/:path*"
    },
    {
      "source": "/chat-api/:path*",
      "destination": "https://finnapigo.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
